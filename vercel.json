{
  "version": 2,
  "buildCommand": "cd plus1-rewards && npm run build",
  "outputDirectory": "plus1-rewards/dist",
  "installCommand": "npm install --prefix plus1-rewards",
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*\\.(png|jpg|jpeg|gif|svg|ico|pdf|json|js|css))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
